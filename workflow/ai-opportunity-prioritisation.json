{
  "name": "AI Opportunity Discovery and Prioritisation",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const original = $json;\n\nfunction validScore(value) {\n  const number = Number(value);\n  if (!Number.isFinite(number)) return 1;\n  return Math.min(5, Math.max(1, number));\n}\n\nconst strategicAlignment = validScore(original.strategic_alignment);\nconst expectedValue = validScore(original.expected_value);\nconst reach = validScore(original.reach);\nconst evidenceStrength = validScore(original.evidence_strength);\nconst feasibility = validScore(original.feasibility);\nconst risk = validScore(original.risk);\n\nconst priorityScore =\n  strategicAlignment * 0.20 +\n  expectedValue * 0.25 +\n  reach * 0.15 +\n  evidenceStrength * 0.10 +\n  feasibility * 0.15 +\n  (6 - risk) * 0.15;\n\nlet priority = \"Low\";\nif (priorityScore >= 4) priority = \"High\";\nelse if (priorityScore >= 3) priority = \"Medium\";\n\nlet decision = \"Place in backlog\";\n\nif (risk >= 4) {\n  decision = \"Governance review required\";\n} else if (evidenceStrength <= 2) {\n  decision = \"More discovery required\";\n} else if (priorityScore >= 4) {\n  decision = \"Candidate for pilot\";\n} else if (priorityScore >= 3) {\n  decision = \"Proceed to discovery\";\n}\n\nreturn [{\n  json: {\n    ...original,\n    opportunity_id: `AIO-${Date.now()}`,\n    submitted_at: new Date().toISOString(),\n    strategic_alignment: strategicAlignment,\n    expected_value: expectedValue,\n    reach,\n    evidence_strength: evidenceStrength,\n    feasibility,\n    risk,\n    priority_score: Number(priorityScore.toFixed(2)),\n    priority,\n    decision,\n    status: \"Initial assessment completed\"\n  }\n}];"
      },
